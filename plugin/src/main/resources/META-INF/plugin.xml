<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>io.github.suhli.elasticsearch.rest</id>
    <name>ES REST Data Source</name>
    <vendor url="https://github.com/suhli/datagrip-es">suhli</vendor>

    <description><![CDATA[
      <p>ES REST Data Source connects DataGrip to Elasticsearch through its REST API.</p>

      <p>It provides a DataGrip data source backed by the Elasticsearch REST API and a
      Dev Tools-style <code>.esrest</code> query console, without using Elasticsearch SQL.</p>

      <h3>Features</h3>
      <ul>
        <li>Connect through the Elasticsearch REST API.</li>
        <li>Browse indices and mapping fields in database tools.</li>
        <li>Execute REST requests from <code>.esrest</code> files.</li>
        <li>Complete API paths, parameters, request bodies, Query DSL, aggregations, and mapping fields.</li>
        <li>Offer dynamic completion for indices, aliases, data streams, and mapping fields.</li>
        <li>Support JSON and NDJSON request bodies.</li>
        <li>Support Basic and API Key authentication, with configurable TLS certificate verification.</li>
        <li>Support Elasticsearch 7.x, 8.x, and 9.x.</li>
      </ul>

      <p>ES REST Data Source is an independent open-source project and is not affiliated
      with or endorsed by Elasticsearch B.V., Elastic, or JetBrains.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.database</depends>
    <depends>com.intellij.modules.sql</depends>

    <!--
      Database Tools has no documented Java extension point for contributing a
      preconfigured basic JDBC driver. These declarative extension points are
      the mechanism used by JetBrains' own driver-bundling reference plugin.
      Keep this compatibility-sensitive integration isolated in this module.
    -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Elasticsearch REST"
            language="ElasticsearchREST"
            implementationClass="io.github.suhli.datagrip.elasticsearch.plugin.language.EsRestFileType"
            fieldName="INSTANCE"
            extensions="esrest"/>
        <lang.parserDefinition
            language="ElasticsearchREST"
            implementationClass="io.github.suhli.datagrip.elasticsearch.plugin.language.EsRestParserDefinition"/>
        <lang.syntaxHighlighterFactory
            language="ElasticsearchREST"
            implementationClass="io.github.suhli.datagrip.elasticsearch.plugin.language.EsRestSyntaxHighlighterFactory"/>
        <lang.pairedBraceMatcher
            language="ElasticsearchREST"
            implementationClass="io.github.suhli.datagrip.elasticsearch.plugin.language.EsRestBraceMatcher"/>
        <lang.braceMatcher
            language="ElasticsearchREST"
            implementationClass="io.github.suhli.datagrip.elasticsearch.plugin.language.EsRestPairedBraceMatcher"/>
        <editorHighlighterProvider
            filetype="Elasticsearch REST"
            implementationClass="io.github.suhli.datagrip.elasticsearch.plugin.language.EsRestEditorHighlighterProvider"/>
        <lang.formatter
            language="ElasticsearchREST"
            implementationClass="io.github.suhli.datagrip.elasticsearch.plugin.language.EsRestFormattingModelBuilder"/>
        <preFormatProcessor
            implementation="io.github.suhli.datagrip.elasticsearch.plugin.language.EsRestPreFormatProcessor"/>
        <copyPastePreProcessor
            implementation="io.github.suhli.datagrip.elasticsearch.plugin.language.EsRestCopyPastePreProcessor"/>
        <sql.dialect
            dbms="ELASTICSEARCH"
            implementationClass="io.github.suhli.datagrip.elasticsearch.plugin.language.EsRestLanguage"/>
        <sql.evaluationHelper
            language="ElasticsearchREST"
            implementationClass="io.github.suhli.datagrip.elasticsearch.plugin.language.EsRestEvaluationHelper"/>
        <completion.contributor
            language="ElasticsearchREST"
            implementationClass="io.github.suhli.datagrip.elasticsearch.plugin.completion.EsRestCompletionContributor"/>
        <database.driversConfig config="databaseDrivers/elasticsearch-rest.xml"/>
        <database.artifactsConfig config="databaseDrivers/elasticsearch-rest-artifacts.xml"/>
    </extensions>
</idea-plugin>
